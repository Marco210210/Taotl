{
  "expo": {
    "name": "Taotl",
    "slug": "taotl-conteggio",
    "scheme": "taotl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.taotl.conteggio"
    },
    "android": {
      "package": "app.taotl.conteggio",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "it",
      "description": "Taotl: conteggio partite, turni e classifiche.",
      "themeColor": "#F8F8F5"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Taotl usa la libreria immagini solo per scegliere la foto del profilo.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "./plugins/with-android-build-memory",
      "expo-localization",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "826edabd-a3a1-43d5-946d-251c755d9323"
      }
    },
    "owner": "marco2102s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/826edabd-a3a1-43d5-946d-251c755d9323"
    }
  }
}
