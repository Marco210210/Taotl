# Copiare in /home/ubuntu/.config/taotl-monitor.env (permessi 600).
# Non inserire mai questi valori nell'app, nel repository o nelle variabili EXPO_PUBLIC_*.
TAOTL_TELEGRAM_BOT_TOKEN=token-generato-da-BotFather
TAOTL_TELEGRAM_CHAT_ID=id-numerico-della-chat

# Generare con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TAOTL_MONITOR_KEY=sostituire-con-chiave-casuale-privata
