# Gmail API con OAuth 2.0 (configurazione consigliata)
TAOTL_MAIL_TRANSPORT=gmail_api
TAOTL_MAIL_FROM=Taotl <apptaotl@gmail.com>
TAOTL_GMAIL_TOKEN_FILE=/home/ubuntu/.config/taotl/google-oauth-token.json

# SMTP (alternativa)
TAOTL_SMTP_HOST=smtp.gmail.com
TAOTL_SMTP_PORT=465
TAOTL_SMTP_USERNAME=mittente@gmail.com
TAOTL_SMTP_PASSWORD=password-per-app-google
TAOTL_SMTP_FROM=mittente@gmail.com
TAOTL_SMTP_SSL=true
TAOTL_ORACLE_WALLET_DIR=/home/ubuntu/.config/taotl/wallet
TAOTL_ORACLE_DSN=MYATP_high_tls
